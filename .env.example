# Copy to .env and fill in. Never commit .env.

# --- Postgres (n8n database + processed email log) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=

# --- n8n ---
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_VERSION=latest
N8N_WEBHOOK_URL=http://localhost:5678/
TZ=Europe/Warsaw

# --- LLM ---
# API keys are stored as n8n credentials, not here.
# Provider: google (Gemini, free tier at aistudio.google.com) | anthropic | openai
LLM_PROVIDER=google
# Gemini model ID as listed in the n8n Gemini node or AI Studio.
LLM_MODEL=models/gemini-3-flash-preview

# --- api/ service ---
MAX_DISCOUNT_PERCENT=10
LOG_LEVEL=info

# --- Google Workspace ---
# ID from the price list URL: docs.google.com/spreadsheets/d/<ID>/edit
PRICE_LIST_SHEET_ID=

# --- Notifications ---
SLACK_CHANNEL=#sales-assistant
